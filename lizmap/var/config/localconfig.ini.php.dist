;<?php exit(''); ?>
;for security reasons , don't remove or modify the first line

; put here configuration variables that are specific to this installation


; chmod for files created by Lizmap and Jelix
;chmodFile=0664
;chmodDir=0775



[modules]
;; uncomment it if you want to use ldap for authentication
;; see documentation to complete the ldap configuration
;ldapdao.enable=on

[qgisWrapper]
; If off, FCGI is not allowed, only Py-QGIS-Server or QJazz
; https://docs.lizmap.com/current/en/install/py-qgis-server.html
; https://docs.3liz.org/py-qgis-server/
; https://github.com/3liz/qjazz
; allowFcgi=off

[coordplugin_auth]
;; uncomment it if you want to use ldap for authentication
;; see documentation to complete the ldap configuration
;driver=ldapdao


[mailer]
;; to send email via SMTP, uncomment this line, and fill the section smtp:mailer into profiles.ini.php
;mailerType=smtp


[auth_db]
; uncomment to enable authentication with the login or the email
;authenticateWith=login-email


[lizmapAi]
;; AI assistant of the data catalog (search in natural language and layer analysis), with Claude.
;; It needs an Anthropic API key: https://console.anthropic.com/
;; Only the metadata of the layers the user can see and aggregated statistics of the attributes
;; (no rows, no geometries) are sent to the Anthropic API.
;enabled=on
;; the API key, or leave it empty and set the ANTHROPIC_API_KEY environment variable of PHP
;apiKey=
;model=claude-opus-5-5
;; claude (default), or ollama to use a model running on a server of yours (nothing leaves your network);
;; with ollama, set model to a model pulled on that server, e.g. qwen3:14b, and its URL:
;provider=claude
;ollamaUrl=http://localhost:11434
;; let anonymous users use the assistant (each request has a cost)
;allowAnonymous=off
;; send aggregated statistics of the attributes for the layer analysis (off: metadata only)
;sendStatistics=on
;; number of features read for the statistics
;maxFeatures=1000
