;<?php exit(''); ?>
;for security reasons , don't remove or modify the first line

; put here configuration variables that are specific to this installation


; chmod for files created by Lizmap and Jelix
;chmodFile=0664
;chmodDir=0775



[modules]
;; uncomment it if you want to use ldap for authentication
;; see documentation to complete the ldap configuration
;ldapdao.enable=on

[qgisWrapper]
; If off, FCGI is not allowed, only Py-QGIS-Server or QJazz
; https://docs.lizmap.com/current/en/install/py-qgis-server.html
; https://docs.3liz.org/py-qgis-server/
; https://github.com/3liz/qjazz
; allowFcgi=off

[coordplugin_auth]
;; uncomment it if you want to use ldap for authentication
;; see documentation to complete the ldap configuration
;driver=ldapdao


[mailer]
;; to send email via SMTP, uncomment this line, and fill the section smtp:mailer into profiles.ini.php
;mailerType=smtp


[auth_db]
; uncomment to enable authentication with the login or the email
;authenticateWith=login-email

;[catalogImport]
; Quota of the files imported in the data catalog and saved in the user
; profile (needs the right "lizmap.tools.import.save" on the repository)
; maximum size of the saved files of a user, in MB
;quotaSize=20
; maximum number of saved files of a user
;quotaLayers=20
; DWG files are converted to DXF with ODA File Converter (https://www.opendesign.com/guestfiles/oda_file_converter)
; or dwg2dxf of LibreDWG, found in the PATH, else read by GDAL (DWG R2000 only).
; Path of the converter, when it is not in the PATH
;dwgConverter=/usr/bin/ODAFileConverter

[lizmapAi]
;; AI assistant of the data catalog (search in natural language and layer analysis).
;; By default a local model served by Ollama (https://ollama.com), nothing leaves your network:
;; install Ollama, then `ollama pull gemma3:4b`.
;; Only the metadata of the layers the user can see and aggregated statistics of the attributes
;; (no rows, no geometries) are sent to the AI provider.
;enabled=on
;; provider: ollama (default), claude, openai, mistral, gemini or openai-compatible
;; (LM Studio, vLLM, Groq, OpenRouter...)
;provider=ollama
;; the API key, or leave it empty and set the environment variable of PHP:
;; ANTHROPIC_API_KEY, OPENAI_API_KEY, MISTRAL_API_KEY or GEMINI_API_KEY. Not needed for ollama.
;apiKey=
;; the model: gemma3:4b by default with ollama, claude-opus-5-5 with claude,
;; required with the other providers
;model=
;; the API URL: for ollama (default http://localhost:11434, http://host.docker.internal:11434 from Docker)
;; and openai-compatible (e.g. http://localhost:1234/v1)
;url=
;; let anonymous users use the assistant (each request has a cost)
;allowAnonymous=off
;; send aggregated statistics of the attributes for the layer analysis (off: metadata only)
;sendStatistics=on
;; number of features read for the statistics
;maxFeatures=1000
